{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/comodel/phase.schema.json",
  "title": "CoModel Phase",
  "type": "object",
  "required": ["id", "project_id", "phase_key", "revision", "title", "status", "dependencies"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "phase_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["not_started", "queued", "running", "awaiting_review", "approved", "blocked", "failed", "cancelled", "skipped"]},
    "dependencies": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "scope_component_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "expected_scene_version": {"type": "integer", "minimum": 0},
    "result_scene_version": {"type": ["integer", "null"], "minimum": 0},
    "requires_approval": {"type": "boolean", "default": true}
  },
  "additionalProperties": false
}
